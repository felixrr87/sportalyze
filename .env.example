# ============================================================
# SPORTALYZE — Variables de entorno
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena tus valores reales
# 3. NUNCA subas .env a GitHub (ya está en .gitignore)
# ============================================================

# Tu API key de football-data.org (gratis en football-data.org)
FOOTBALL_API_KEY=18f8f363554247f69bba9b7a9d049da8

# Puerto del servidor (por defecto 8000)
PORT=8000

# Entorno (development / production)
ENV=development

# Caché en segundos (3600 = 1 hora)
CACHE_TTL=3600

# Base de datos (SQLite para dev, PostgreSQL para producción)
DATABASE_URL=sqlite:///./sportalyze.db

# Para Railway (producción) — déjalo vacío en local
# DATABASE_URL=postgresql://user:password@host:5432/sportalyze
